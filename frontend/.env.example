# Copy to .env (or .env.local) and fill in. All keys must be prefixed VITE_.

# Production API base (Cloudflare Worker). Only needed for production builds.
VITE_API_BASE=https://zenith-api.zuha-hassen.workers.dev

# NASA APOD key for the target reference-image waterfall. Optional — the app
# falls back to DEMO_KEY (30 req/hour). Get a free key (1000 req/hour) in ~30s:
# https://api.nasa.gov
VITE_NASA_API_KEY=DEMO_KEY

# Zenith environment variables (copy to .env, do not commit)

# OpenRouter — primary LLM gateway for SessionPlanner (Sonnet) and
# Explainer (Haiku). Get a key from https://openrouter.ai/keys.
# Without this set, /api/plan-ai degrades gracefully (returns the
# deterministic plan with ai_plan.error populated) and /api/explain
# returns 503.
OPENROUTER_API_KEY=

# Direct Anthropic key (optional fallback; not used today).
ANTHROPIC_API_KEY=

# Path to the trained XGBoost seeing model (.json or .ubj). Optional.
SEEING_MODEL_PATH=

# Cloudflare (used by the worker, not the FastAPI process)
CF_ACCOUNT_ID=
CF_API_TOKEN=
